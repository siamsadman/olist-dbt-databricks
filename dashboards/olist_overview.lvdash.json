{
  "datasets": [
    {
      "name": "b8a2eafb",
      "displayName": "kpis",
      "queryLines": [
        "select\r\n",
        "  (select count(*) from workspace.olist_dbt_marts.fact_deliveries) as total_orders,\r\n",
        "  (select round(sum(price), 2) from workspace.olist_dbt_marts.fact_order_items) as total_revenue,\r\n",
        "  (select round(sum(freight_value), 2) from workspace.olist_dbt_marts.fact_order_items) as total_freight,\r\n",
        "  (select round(avg(review_score), 2) from workspace.olist_dbt_marts.fact_reviews) as avg_review_score,\r\n",
        "  (select round(100 * avg(is_late), 2) from workspace.olist_dbt_marts.fact_deliveries) as late_rate_pct,\r\n",
        "  (select round(avg(delivery_days), 2) from workspace.olist_dbt_marts.fact_deliveries) as avg_delivery_days;"
      ],
      "catalog": "workspace",
      "schema": "olist_dbt_marts"
    },
    {
      "name": "114a7010",
      "displayName": "monthly_revenue",
      "queryLines": [
        "select\r\n",
        "  d.year_month,\r\n",
        "  round(sum(i.price), 2) as revenue\r\n",
        "from workspace.olist_dbt_marts.fact_order_items i\r\n",
        "join workspace.olist_dbt_marts.dim_date d\r\n",
        "  on i.order_date_key = d.date_key\r\n",
        "where d.is_complete_month = 1\r\n",
        "group by d.year_month\r\n",
        "order by d.year_month;"
      ],
      "catalog": "workspace",
      "schema": "olist_dbt_marts"
    },
    {
      "name": "88996f85",
      "displayName": "monthly_late_rate",
      "queryLines": [
        "select\r\n",
        "  d.year_month,\r\n",
        "  round(100 * avg(f.is_late), 2) as late_rate_pct,\r\n",
        "  count(*) as orders\r\n",
        "from workspace.olist_dbt_marts.fact_deliveries f\r\n",
        "join workspace.olist_dbt_marts.dim_date d\r\n",
        "  on f.purchase_date_key = d.date_key\r\n",
        "where d.is_complete_month = 1\r\n",
        "group by d.year_month\r\n",
        "having count(*) >= 100\r\n",
        "order by d.year_month;"
      ],
      "catalog": "workspace",
      "schema": "olist_dbt_marts"
    },
    {
      "name": "22942f43",
      "displayName": "score_by_delay",
      "queryLines": [
        "select\r\n",
        "  delay_bucket,\r\n",
        "  round(avg(review_score), 2) as avg_review_score,\r\n",
        "  count(*) as review_rows\r\n",
        "from workspace.olist_dbt_marts.bridge_review_category_delay\r\n",
        "group by delay_bucket\r\n",
        "order by case delay_bucket\r\n",
        "  when 'On Time' then 1\r\n",
        "  when '1-7 Days Late' then 2\r\n",
        "  when '8-14 Days Late' then 3\r\n",
        "  when '15+ Days Late' then 4\r\n",
        "  else 5\r\n",
        "end;"
      ]
    },
    {
      "name": "98742727",
      "displayName": "state_delivery_vs_score",
      "queryLines": [
        "with delivery as (\r\n",
        "  select\r\n",
        "    c.customer_state,\r\n",
        "    avg(f.delivery_days) as avg_delivery_days,\r\n",
        "    count(*) as orders\r\n",
        "  from workspace.olist_dbt_marts.fact_deliveries f\r\n",
        "  join workspace.olist_dbt_marts.dim_customer c\r\n",
        "    on f.customer_unique_id = c.customer_unique_id\r\n",
        "  group by c.customer_state\r\n",
        "),\r\n",
        "reviews as (\r\n",
        "  select\r\n",
        "    c.customer_state,\r\n",
        "    avg(r.review_score) as avg_review_score\r\n",
        "  from workspace.olist_dbt_marts.bridge_review_order b\r\n",
        "  join workspace.olist_dbt_marts.fact_reviews r\r\n",
        "    on b.review_id = r.review_id\r\n",
        "  join workspace.olist_dbt_marts.dim_customer c\r\n",
        "    on b.customer_unique_id = c.customer_unique_id\r\n",
        "  group by c.customer_state\r\n",
        ")\r\n",
        "select\r\n",
        "  delivery.customer_state,\r\n",
        "  round(delivery.avg_delivery_days, 2) as avg_delivery_days,\r\n",
        "  round(reviews.avg_review_score, 2) as avg_review_score,\r\n",
        "  delivery.orders\r\n",
        "from delivery\r\n",
        "join reviews on delivery.customer_state = reviews.customer_state\r\n",
        "order by delivery.avg_delivery_days;"
      ],
      "catalog": "workspace",
      "schema": "olist_dbt_marts"
    },
    {
      "name": "8089357c",
      "displayName": "payment_mix",
      "queryLines": [
        "select\r\n",
        "  payment_type,\r\n",
        "  round(sum(payment_value), 2) as payment_value,\r\n",
        "  count(distinct order_id) as orders\r\n",
        "from workspace.olist_dbt_marts.fact_payments\r\n",
        "where payment_type <> 'not_defined'\r\n",
        "group by payment_type\r\n",
        "order by payment_value desc;"
      ],
      "catalog": "workspace",
      "schema": "olist_dbt_marts"
    }
  ],
